<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
  <packageSources>
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <add key="AMAIS_PUM" value="https://pkgs.dev.azure.com/PetraCMS/PetraCMS/_packaging/AMAIS_PUM/nuget/v3/index.json" />
    <add key="AMAIS_DXP" value="https://pkgs.dev.azure.com/PetraCMS/PetraCMS/_packaging/AMAIS_DXP/nuget/v3/index.json" />
  </packageSources>
  <!-- Learn how package source mapping works
  https://docs.microsoft.com/en-us/nuget/consume-packages/package-source-mapping?Wt.mc_id=DX_MVP5000553 -->
  <packageSourceMapping>
    <!-- Use the nuget.org for everything else -->
    <packageSource key="NuGet">
      <package pattern="*" />
    </packageSource>

    <!-- This mapping group will use the 'AMAIS_DXP' package source for ONLY relevant packages.-->
    <packageSource key="AMAIS_PUM">
      <package pattern="AMAIS.PUM.*" />
    </packageSource>

    <packageSource key="AMAIS_DXP">
      <package pattern="AMAIS.DXP.*" />
    </packageSource>

  </packageSourceMapping>
</configuration>